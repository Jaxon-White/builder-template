# Where resource data comes from: "mock" (sample data, default) or "sharepoint" (not built yet).
DATA_SOURCE=mock

# Needed once DATA_SOURCE=sharepoint is implemented. Server-side only; never prefix with NEXT_PUBLIC_.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=
SHAREPOINT_CHECKLOG_LIST_ID=

# How people sign in: "demo" (pick a sample account, default) or "church" (Church Account, not built yet).
AUTH_MODE=demo
# Signs the session cookie. Required for real use; any long random string.
AUTH_SECRET=

# Needed once AUTH_MODE=church is implemented. The Church provides these when it registers the app.
CHURCH_OIDC_ISSUER=
CHURCH_CLIENT_ID=
CHURCH_CLIENT_SECRET=
